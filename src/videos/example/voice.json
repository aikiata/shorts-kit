  "lines": [
    {
      "scene": "hook",
      "index": 0,
      "text": "Sunlight looks white, so why is the clear sky above you blue and not white too?",
      "start": 0,
      "end": 4.43
    },
    {
      "scene": "problem",
      "index": 0,
      "text": "White sunlight carries all the colours of the rainbow, so why does the sky pick out the blue?",
      "start": 5.33,
      "end": 10.3
    },
    {
      "scene": "layer1",
      "index": 0,
      "text": "Each colour travels as a wave, and blue light travels in shorter waves than red light.",
      "start": 11.2,
      "end": 15.81
    },
    {
      "scene": "layer2",
      "index": 0,
      "text": "The air above you is full of gas molecules, and all that sunlight has to pass through them.",
      "start": 16.71,
      "end": 21.55
    },
    {
      "scene": "hardest",
      "index": 0,
      "text": "Gas molecules scatter blue light in all directions more than the other colours, so blue reaches you from the whole sky.",
      "start": 22.45,
      "end": 28.69
    },
    {
      "scene": "payoff",
      "index": 0,
      "text": "Near the horizon the sky looks paler, because that light crossed more air and its blue was scattered many times in many directions.",
      "start": 29.59,
      "end": 36.31
    },
    {
      "scene": "share",
      "index": 0,
      "text": "Send this to the next person who asks you why the sky is blue.",
      "start": 37.21,
      "end": 40.5
    }
  ],
